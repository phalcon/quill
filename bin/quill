#!/usr/bin/env php
<?php

/**
 * This file is part of the Phalcon Quill.
 *
 * (c) Phalcon Team <team@phalcon.io>
 *
 * For the full copyright and license information, please view the LICENSE
 * file that was distributed with this source code.
 */

declare(strict_types=1);

use Composer\InstalledVersions;
use Phalcon\Quill\Cli\DocblocksCommand;
use Phalcon\Quill\Cli\GenerateCommand;
use Phalcon\Quill\Cli\ParityCommand;
use Phalcon\Quill\Config;
use Phalcon\Quill\Exceptions\Exception;
use Phalcon\Quill\Formatter\FormatterFactory;
use Phalcon\Quill\Reader\ReaderFactory;
use Phalcon\Quill\Selection;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
    if (file_exists($file)) {
        require_once $file;

        break;
    }
}

/**
 * The identity line a run opens with: the nib mark, the tool name and its
 * version, then what the tool is. The mark carries no escapes of its own when
 * the output is piped or NO_COLOR is set, so only the glyph survives.
 */
$mark    = '///';
$version = class_exists(InstalledVersions::class)
    && InstalledVersions::isInstalled('phalcon/quill')
    ? InstalledVersions::getPrettyVersion('phalcon/quill') ?? 'dev'
    : 'dev';
$logo    = getenv('NO_COLOR') === false && stream_isatty(STDOUT)
    ? "\033[38;5;62m" . $mark . "\033[0m"
    : $mark;

$banner = $logo . ' quill ' . $version . PHP_EOL
    . 'API Documentation Generator' . PHP_EOL;

$usage = $banner . <<<'USAGE'

    Usage:
      quill generate [filter] [--config=<path>] [--output=<dir>] [--format=<name>]
                     [--namespace=<ns>]
      quill parity <left.json> <right.json>
      quill docblocks <left.json> <right.json> <out.csv>

    parity reports structural differences between two model documents.
    docblocks writes the documentation disagreements to a spreadsheet, with a
    winner column to fill in.

    Paths, repository and language come from a quill.php at the project root.
    --config points elsewhere; --output overrides just the destination;
    --format picks the output (markdown or json), defaulting to markdown. The
    optional filter limits what is written, matched case-insensitively.

    --namespace limits the run to one namespace and everything beneath it,
    matched exactly. The configured root is implied, so Config and
    Phalcon\Config mean the same thing. A namespace matching nothing is an
    error rather than an empty document.

    USAGE;

$argv    = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? null;

if ($command === null || in_array($command, ['-h', '--help', 'help'], true)) {
    fwrite(STDOUT, $usage);

    exit(0);
}

/**
 * The tokens after the command name that are not options, in order. Both
 * comparison commands take their arguments positionally and neither accepts
 * an option, so an option among them is dropped rather than rejected.
 *
 * @param list<string> $argv
 *
 * @return list<string>
 */
$positionals = static function (array $argv): array {
    return array_values(array_filter(
        array_slice($argv, 2),
        static fn (string $token): bool => !str_starts_with($token, '-')
    ));
};

if ($command === 'docblocks') {
    $args = $positionals($argv);

    if (count($args) !== 3) {
        fwrite(STDERR, 'quill: docblocks needs two model documents and a csv path' . PHP_EOL . $usage);

        exit(1);
    }

    try {
        exit((new DocblocksCommand())->execute($args[0], $args[1], $args[2]));
    } catch (Exception $exception) {
        fwrite(STDERR, 'quill: ' . $exception->getMessage() . PHP_EOL);

        exit(1);
    }
}

if ($command === 'parity') {
    $paths = $positionals($argv);

    if (count($paths) !== 2) {
        fwrite(STDERR, 'quill: parity needs two model documents' . PHP_EOL . $usage);

        exit(1);
    }

    try {
        exit((new ParityCommand())->execute($paths[0], $paths[1]));
    } catch (Exception $exception) {
        fwrite(STDERR, 'quill: ' . $exception->getMessage() . PHP_EOL);

        exit(1);
    }
}

if ($command !== 'generate') {
    fwrite(STDERR, "quill: unknown command '{$command}'" . PHP_EOL . $usage);

    exit(1);
}

$configPath = 'quill.php';
$outputDir  = null;
$format     = 'markdown';
$filter     = '';
$namespace  = '';

foreach (array_slice($argv, 2) as $token) {
    if (str_starts_with($token, '--config=')) {
        $configPath = substr($token, 9);

        continue;
    }

    if (str_starts_with($token, '--output=')) {
        $outputDir = substr($token, 9);

        continue;
    }

    if (str_starts_with($token, '--format=')) {
        $format = substr($token, 9);

        continue;
    }

    if (str_starts_with($token, '--namespace=')) {
        $namespace = substr($token, 12);

        continue;
    }

    if (str_starts_with($token, '-')) {
        fwrite(STDERR, "quill: unknown option '{$token}'" . PHP_EOL . $usage);

        exit(1);
    }

    $filter = $token;
}

try {
    $config = Config::fromFile($configPath);
    if ($outputDir !== null) {
        $config = $config->withOutputDir($outputDir);
    }

    $command = new GenerateCommand(
        new ReaderFactory(),
        (new FormatterFactory())->create($format)
    );

    exit($command->execute($config, Selection::of($filter, $namespace, $config)));
} catch (Exception $exception) {
    fwrite(STDERR, 'quill: ' . $exception->getMessage() . PHP_EOL);

    exit(1);
}
