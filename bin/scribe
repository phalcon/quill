 * file that was distributed with this source code.
 */

declare(strict_types=1);

use Phalcon\Scribe\Cli\GenerateCommand;
use Phalcon\Scribe\Config;
use Phalcon\Scribe\Exceptions\Exception;
use Phalcon\Scribe\Formatter\MarkdownFormatter;
use Phalcon\Scribe\Reader\ReaderFactory;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
    if (file_exists($file)) {
        require_once $file;

        break;
    }
}

$usage = <<<'USAGE'
    Scribe API documentation generator

    Usage:
      scribe generate [filter] [--config=<path>] [--output=<dir>]

    Paths, repository and language come from a scribe.php at the project root.
    --config points elsewhere; --output overrides just the destination. The
    optional filter limits which pages are written, matched case-insensitively
    against the page key.

    USAGE;

$argv    = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? null;

if ($command === null || in_array($command, ['-h', '--help', 'help'], true)) {
    fwrite(STDOUT, $usage);

    exit(0);
}

if ($command !== 'generate') {
    fwrite(STDERR, "scribe: unknown command '{$command}'" . PHP_EOL . $usage);

    exit(1);
}

$configPath = 'scribe.php';
$outputDir  = null;
$filter     = '';

foreach (array_slice($argv, 2) as $token) {
    if (str_starts_with($token, '--config=')) {
        $configPath = substr($token, 9);

        continue;
    }

    if (str_starts_with($token, '--output=')) {
        $outputDir = substr($token, 9);

        continue;
    }

    if (str_starts_with($token, '-')) {
        fwrite(STDERR, "scribe: unknown option '{$token}'" . PHP_EOL . $usage);

        exit(1);
    }

    $filter = $token;
}

try {
    $config = Config::fromFile($configPath);
    if ($outputDir !== null) {
        $config = $config->withOutputDir($outputDir);
    }

    $command = new GenerateCommand(new ReaderFactory(), new MarkdownFormatter());

    exit($command->execute($config, $filter));
} catch (Exception $exception) {
    fwrite(STDERR, 'scribe: ' . $exception->getMessage() . PHP_EOL);

    exit(1);
}
