{
    "name": "phalcon/quill",
    "description": "API documentation generator for Zephir and PHP sources",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": ["phalcon", "documentation", "api", "zephir", "generator"],
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.1",
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phalcon/talon": "^0.9",
        "phalcon/zephir": "dev-development",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3 || ^4"
    },
    "suggest": {
        "phalcon/zephir": "Required by ZephirReader to parse .zep sources"
    },
    "autoload": {
        "psr-4": { "Phalcon\\Quill\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Phalcon\\Quill\\Tests\\": "tests/" }
    },
    "bin": ["bin/quill"],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyze": "phpstan analyse -c resources/phpstan.neon",
        "cs": "phpcs --standard=resources/phpcs.xml",
        "cs-fix": "phpcbf --standard=resources/phpcs.xml",
        "cs-fixer": "php-cs-fixer fix --config=resources/php-cs-fixer.php --dry-run --diff",
        "cs-fixer-fix": "php-cs-fixer fix --config=resources/php-cs-fixer.php",
        "infection": "infection --configuration=resources/infection.json5 --threads=max",
        "test": "talon run unit",
        "test-coverage": "talon run unit -- --coverage-clover tests/_output/coverage.xml"
    }
}
